<Window x:ConnectionId='1' x:Class="sysinfo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:effects="clr-namespace:System.Windows.Media.Effects;assembly=PresentationCore"

             Title="Borderless Window"
        
        x:Name="RootWindow">


    <Grid x:ConnectionId='2' x:Name="RootGrid"                                           
          
                                                    >
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions >
        <Grid Grid.Row="0" Background="Transparent" Margin="0,25,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />

            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1"
                  >

                <Grid 
                          HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                          
                          >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>

                    </Grid.RowDefinitions>
                    <TextBlock x:ConnectionId='33' Grid.Row="0" x:Name="HourTb"  VerticalAlignment="Center" HorizontalAlignment="Center"  FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/BigShouldersStencil.ttf#Big Shoulders Stencil Thin"  FontSize="80"  />

                    <TextBlock x:ConnectionId='34' Grid.Row="1" x:Name="MinuteTb"  VerticalAlignment="Bottom" FontFamily="/Assets/Fonts/BigShouldersStencil.ttf#Big Shoulders Stencil Thin" HorizontalAlignment="Center"  FontSize="45" FontWeight="400" />
                    <TextBlock x:ConnectionId='35' Grid.Row="2" x:Name="SecondTb"  VerticalAlignment="Bottom" FontFamily="/Assets/Fonts/BigShouldersStencil.ttf#Big Shoulders Stencil Thin" HorizontalAlignment="Center" FontSize="35"  FontWeight="400" Opacity="1"  />


                    <Grid.Resources>
                        <Storyboard x:ConnectionId='36' x:Name="SecondAnimation">
                            <DoubleAnimation 
                                Storyboard.TargetName="SecondTb"
                                Storyboard.TargetProperty="Opacity"
                                From="0"
                                To="1"
                                Duration="0:0:1"/>
                        </Storyboard>
                    </Grid.Resources>
                </Grid>
            </Grid>
            <Grid Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Image x:ConnectionId='28' Grid.Row="0" x:Name="WeatherIcon"  VerticalAlignment="Center" HorizontalAlignment="Center" Width="128" Height="128" Stretch="Uniform" Margin="2"/>
                <TextBlock x:ConnectionId='29' Grid.Row="1" x:Name="WeatherTb"  VerticalAlignment="Center" HorizontalAlignment="Center"  FontStyle="Normal" FontWeight="900" FontFamily="/Assets/Fonts/IRANSansX-Regular.ttf#IRANSansX"  FontSize="12"  />
                <TextBlock x:ConnectionId='30' Grid.Row="2" x:Name="DayNumTb"  VerticalAlignment="Center" HorizontalAlignment="Center"  FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto"  FontSize="80"  />
                <TextBlock x:ConnectionId='31' Grid.Row="3" x:Name="DayOfWeekTb"   VerticalAlignment="Center" HorizontalAlignment="Center"   FontStyle="Normal" FontWeight="900" FontFamily="/Assets/Fonts/IRANSansX-Regular.ttf#IRANSansX"  FontSize="15"  />
                <TextBlock x:ConnectionId='32' Grid.Row="4" x:Name="MonthTb"  VerticalAlignment="Center" HorizontalAlignment="Center"  FontStyle="Normal" FontWeight="900" FontFamily="/Assets/Fonts/IRANSansX-Regular.ttf#IRANSansX"  FontSize="13"  />

            </Grid>


        </Grid>
       

        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-30,0,0"  >

           
