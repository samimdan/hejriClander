                        <ScaleTransform ScaleX="1.2" ScaleY="1.2"/>
                    </Path.RenderTransform>
                </Path>

                <TextBlock x:ConnectionId='21' x:Name="UvTb"  VerticalAlignment="Center" HorizontalAlignment="Center"  FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto"  Margin="0,20,4,0"  />
                
             

             
            </StackPanel>
           
        </StackPanel>

        <TextBlock x:ConnectionId='3'  Grid.Row="2" x:Name="WeatherDescriptionTb" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto"  FontSize="10" Opacity="0.7" TextWrapping="Wrap"  HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,50"/>
      
        <Line Grid.Row="1" Stroke="White" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,70,0,0" Opacity="0.1"
              X1="0" Y1="0"
              X2="150" Y2="0"
              StrokeThickness="3"/>
        <StackPanel Grid.Row="2" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-180,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"  >
                <TextBlock x:ConnectionId='17' x:Name="MorningHolyHourTb"  VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"  FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto" />
                <TextBlock Tag="Blinking" Text=":"  VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="20"   FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto" Opacity="1" />
                <TextBlock x:ConnectionId='18' x:Name="MorningHolyMinTb"  VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="20"  FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto" />
                <TextBlock x:ConnectionId='19' x:Name="MorningIcon" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="30" FontFamily="/Assets/Fonts/Weather.ttf#icomoon" Foreground="#00a6f4" Text="&#xe94b;" Margin="110,0,0,0" />

            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" >

               <TextBlock x:ConnectionId='14' x:Name="EveningHolyHourTb"  VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="20"  FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto" Margin="0,10,0,10"/>
               <TextBlock Tag="Blinking" Text=":" FontSize="25" VerticalAlignment="Center" HorizontalAlignment="Center"  FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto" />
                <TextBlock x:ConnectionId='15' x:Name="EveningHolyMinTb"  VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="20"  FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto" />
                <TextBlock x:ConnectionId='16' x:Name="EveningIcon" VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="30" FontFamily="/Assets/Fonts/Weather.ttf#icomoon" Foreground="#ffdf20" Text="&#xe925;" Margin="110,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" >

                <TextBlock x:ConnectionId='11' x:Name="AfterNoonHolyHourTb"  VerticalAlignment="Center" HorizontalAlignment="Center"   FontSize="20" FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto" />
                <TextBlock Tag="Blinking" Text=":" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center"  FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto" />
                <TextBlock x:ConnectionId='12' x:Name="AfterNoonHolyMinTb"  VerticalAlignment="Center" HorizontalAlignment="Center"  FontSize="20"  FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto" />
                <TextBlock x:ConnectionId='13' x:Name="AfterNoonIcon" Foreground="#ff6900"  FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="/Assets/Fonts/Weather.ttf#icomoon" Text="&#xe930;" Margin="110,0,0,0" />

                

            </StackPanel>
            
        </StackPanel>
        <Line Grid.Row="2" Stroke="White" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,0" Opacity="0.1"
              X1="0" Y1="0"
              X2="150" Y2="0"
              StrokeThickness="3"/>
        <StackPanel x:ConnectionId='4' Grid.Row="3" x:Name="ChdataSp" Background="Transparent" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="80" Padding="40" >
         
            <TextBlock x:ConnectionId='8' x:Name="TodayChDateTb" FontSize="25" FontFamily="/Assets/Fonts/BigShouldersStencil.ttf#Big Shoulders Stencil Thin" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:ConnectionId='9' x:Name="MonthChDateTb" FontSize="25" FontFamily="/Assets/Fonts/BigShouldersStencil.ttf#Big Shoulders Stencil Thin"/>
                <TextBlock x:ConnectionId='10' x:Name="MonthChDateTextTb" FontSize="25" FontFamily="/Assets/Fonts/BigShouldersStencil.ttf#Big Shoulders Stencil Thin"/>
            </StackPanel>
        </StackPanel>


        <StackPanel Grid.Row="4" Orientation="Vertical"   VerticalAlignment="Center"  HorizontalAlignment="Center" >
            <StackPanel Orientation="Horizontal"  VerticalAlignment="Center" HorizontalAlignment="Center" >

                <ToggleSwitch x:ConnectionId='6' x:Name="TimerSwitch"  OffContent="Do work" OnContent="Working" IsOn="False"                        />
                <TextBlock x:ConnectionId='7' x:Name="WorkerTimerTb" Text="00:00:00" VerticalAlignment="Center" HorizontalAlignment="Center" FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto"/>
            </StackPanel>
            <Button x:ConnectionId='5' x:Name="ResetTimer" VerticalAlignment="Center" HorizontalAlignment="Center" Content="Reset"                          />
          
        </StackPanel>

    </Grid>
</Window>

