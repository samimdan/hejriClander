                <TextBlock x:ConnectionId='25' x:Name="HumidityTb"  VerticalAlignment="Center" HorizontalAlignment="Center"  FontStyle="Normal" FontWeight="400" FontFamily="/Assets/Fonts/Roboto.ttf#Roboto" Margin="9,20,0,0" />
            </StackPanel>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10,0,10,0" >
                <Path x:ConnectionId='22' x:Name="WindPath"  VerticalAlignment="Center" HorizontalAlignment="Center"  Width="25" Height="25" Fill="White" Data="M3.75,2v20c0,.4141-.3359.75-.75.75s-.75-.3359-.75-.75V2c0-.4141.3359-.75.75-.75s.75.3359.75.75ZM21.75,6.8086v2.3828c0,.8203-.582,1.5391-1.3838,1.7109l-11.9995,2.5723c-.1226.0264-.2461.0391-.3687.0391-.397,0-.7832-.1348-1.0986-.3906-.4126-.334-.6494-.8291-.6494-1.3604v-7.5254c0-.5312.2368-1.0264.6494-1.3604.4131-.334.9497-.4629,1.4663-.3516l12.001,2.5723c.8018.1719,1.3833.8916,1.3833,1.7109ZM11.25,4.6777l-3.1978-.6855c-.0186-.0039-.0366-.0059-.0537-.0059-.0732,0-.1274.0332-.1558.0566-.0347.0273-.0928.0908-.0928.1943v7.5254c0,.1035.0581.167.0928.1943.0352.0293.1069.0732.2104.0508l3.1968-.6853v-6.6448ZM15.25,5.5351l-2.5-.5359v6.0018l2.5-.5359v-4.9299ZM20.25,6.8086c0-.1172-.083-.2197-.1973-.2441h-.0005l-3.3022-.7078v4.2868l3.3022-.7079c.1147-.0244.1978-.127.1978-.2441v-2.3828Z">
