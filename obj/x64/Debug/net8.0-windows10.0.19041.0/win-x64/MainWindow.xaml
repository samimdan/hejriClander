            </StackPanel>
            
            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10,0,10,0" >
                <Path x:ConnectionId='20' x:Name="UvPath"  Width="25" Height="25" Fill="#ffb900" Data="M9,17c0,1.1046-.8954,2-2,2s-2-.8954-2-2c0-.8389.5176-1.5547,1.25-1.8517V5c0-.4141.3359-.75.75-.75s.75.3359.75.75v10.1483c.7324.2969,1.25,1.0128,1.25,1.8517ZM12.75,17c0,3.1709-2.5796,5.75-5.75,5.75s-5.75-2.5791-5.75-5.75c0-1.6777.7241-3.2373,2-4.3359v-7.6641c0-2.0674,1.6821-3.75,3.75-3.75s3.75,1.6826,3.75,3.75v7.6641c1.2759,1.0986,2,2.6582,2,4.3359ZM11.25,17c0-1.3301-.6206-2.5615-1.7021-3.3789-.1875-.1416-.2979-.3633-.2979-.5986V5c0-1.2402-1.0093-2.25-2.25-2.25s-2.25,1.0098-2.25,2.25v8.0225c0,.2354-.1104.4561-.2979.5986-1.0815.8174-1.7021,2.0498-1.7021,3.3789,0,2.3438,1.9067,4.25,4.25,4.25s4.25-1.9062,4.25-4.25ZM14,6.3496c.4141,0,.75-.3359.75-.75v-1.5996c0-.4141-.3359-.75-.75-.75s-.75.3359-.75.75v1.5996c0,.4141.3359.75.75.75ZM18.5254,8.2246c.1919,0,.3838-.0732.5303-.2197l1.1313-1.1318c.293-.293.293-.7676,0-1.0605s-.7676-.293-1.0605,0l-1.1313,1.1318c-.293.293-.293.7676,0,1.0605.1465.1465.3384.2197.5303.2197ZM22,11.25h-1.6001c-.4141,0-.75.3359-.75.75s.3359.75.75.75h1.6001c.4141,0,.75-.3359.75-.75s-.3359-.75-.75-.75ZM19.0557,15.9951c-.293-.293-.7676-.293-1.0605,0s-.293.7676,0,1.0605l1.1313,1.1318c.1465.1465.3384.2197.5303.2197s.3838-.0732.5303-.2197c.293-.293.293-.7676,0-1.0605l-1.1313-1.1318ZM14,17.6504c-.0118,0-.0216.0062-.0333.0067-.0814.8691-.3267,1.6895-.6976,2.4377.0486.3672.3504.6552.7308.6552.4141,0,.75-.3359.75-.75v-1.5996c0-.4141-.3359-.75-.75-.75ZM14,8.0498c-.7328,0-1.4112.214-2,.5631v1.9805c.4439-.6292,1.1732-1.0436,2-1.0436,1.3511,0,2.4502,1.0996,2.4502,2.4502s-1.0991,2.4502-2.4502,2.4502c-.1733,0-.3415-.0234-.5067-.058.2004.4949.3372,1.0154.4187,1.5505.0295.0007.0584.0075.088.0075,2.1782,0,3.9502-1.7725,3.9502-3.9502s-1.772-3.9502-3.9502-3.9502Z">
